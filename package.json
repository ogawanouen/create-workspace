{
  "name": "@ogawanouen/create-workspace",
  "version": "0.0.4",
  "description": "monorepoとworkspaceを作成するCLI",
  "repository": {
    "type": "git",
    "url": "https://github.com/ogawanouen/create-workspace.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "bin": {
    "create-workspace": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "docs:dev": "pnpm --dir docs dev",
    "typecheck": "tsc --noEmit",
    "check": "biome check .",
    "fix": "biome check --write .",
    "format": "biome format --write .",
    "prepack": "pnpm fix && pnpm typecheck && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "^24.22.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@types/node": "^24.19.2",
    "lefthook": "2.2.2",
    "tsdown": "0.23.2",
    "typescript": "7.0.2"
  }
}
